# Normalize text files to LF in the repository (checkout as-is on all
# platforms) so gofmt -l and diffs are line-ending-clean.
*.go text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.syso binary
*.ico binary
**/testdata/fuzz/** -text
# Linux packaging must keep LF (phase 12 F19: CRLF breaks systemd, sudo, sh).
*.service text eol=lf
*.sh text eol=lf
packaging/posture/sudoers.* text eol=lf
